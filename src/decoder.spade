use lib::instructions::Op;

pub struct DecodedOp {
    op: Op,
    bytes: uint<3>,
}

impl Option<DecodedOp> {
    pub fn into_op(self) -> Option<Op> {
        match self {
            Some(value) => Some(value.op),
            None => None,
        }
    }
}

pub fn decode(value: uint<32>) -> DecodedOp {
    let a = decode_angles(trunc(value >> 16));
    let b = decode_angles(trunc(value));
    let invalid_4 = DecodedOp(Op::Invalid, 4);
    match a {
        (Angle::W, Angle::A, Angle::A, Angle::W, Angle::Pad, false) => DecodedOp(Op::Add, 2),
        (Angle::W, Angle::A, Angle::Q, Angle::A, Angle::W, false) => DecodedOp(Op::Multiply, 2),

        (Angle::Q, Angle::Q, Angle::A, Angle::E, Angle::Pad, false) => DecodedOp(Op::ShiftLeft, 2),
        (Angle::E, Angle::A, Angle::Q, Angle::Q, Angle::Pad, false) => DecodedOp(Op::ArithShiftRight, 2),
        (Angle::E, Angle::A, Angle::Q, Angle::Q, Angle::D, true) => match b {
            (Angle::E, Angle::E, Angle::Pad, Angle::Pad, Angle::Pad, false) => DecodedOp(Op::LogicShiftRight, 4),
            _ => invalid_4,
        },

        (Angle::A, Angle::W, Angle::D, Angle::D, Angle::Pad, false) => DecodedOp(Op::If, 2),
        (Angle::A, Angle::D, Angle::Pad, Angle::Pad, Angle::Pad, false) => DecodedOp(Op::Equals, 2),
        (Angle::D, Angle::A, Angle::Pad, Angle::Pad, Angle::Pad, false) => DecodedOp(Op::NotEquals, 2),
        (Angle::E, Angle::Pad, Angle::Pad, Angle::Pad, Angle::Pad, false) => DecodedOp(Op::Greater, 2),
        (Angle::E, Angle::E, Angle::Pad, Angle::Pad, Angle::Pad, false) => DecodedOp(Op::GreaterEq, 2),
        (Angle::Q, Angle::Pad, Angle::Pad, Angle::Pad, Angle::Pad, false) => DecodedOp(Op::Less, 2),
        (Angle::Q, Angle::Q, Angle::Pad, Angle::Pad, Angle::Pad, false) => DecodedOp(Op::LessEq, 2),

        (Angle::A, Angle::A, Angle::D, Angle::A, Angle::A, false) => DecodedOp(Op::Duplicate, 2),
        (Angle::A, Angle::A, Angle::D, Angle::A, Angle::D, true) => match b {
            (Angle::A, Angle::A, Angle::W, Angle::Pad, Angle::Pad, false) => DecodedOp(Op::Duplicate2, 4),
            _ => invalid_4,
        },
        (Angle::A, Angle::A, Angle::W, Angle::D, Angle::D, false) => DecodedOp(Op::Swap, 2),

        (Angle::Number, _, _, _, _, _) => DecodedOp(
            Op::Number(sext::<29, _>(trunc(value.as_int()))), 4
        ),

        _ => DecodedOp(Op::Invalid, 2),
    }
}

fn decode_angles(value: uint<16>) -> (Angle, Angle, Angle, Angle, Angle, bool) {
    let a = decode_angle(trunc(value >> 13));
    let b = decode_angle(trunc(value >> 10));
    let c = decode_angle(trunc(value >> 7));
    let d = decode_angle(trunc(value >> 4));
    let e = decode_angle(trunc(value >> 1));
    let continue = value.lsb();
    (a, b, c, d, e, continue)
}

enum Angle {
    // Padding at the end of patterns
    Pad,
    A,
    Q,
    W,
    E,
    D,
    Number,
    Reserved,
}

fn decode_angle(value: uint<3>) -> Angle {
    match value {
        0b000 => Angle::Pad,
        0b001 => Angle::A,
        0b010 => Angle::Q,
        0b011 => Angle::W,
        0b100 => Angle::E,
        0b101 => Angle::D,
        0b110 => Angle::Number,
        0b111 => Angle::Reserved,
    }
}
